  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Observation Log \u2014 Subject Class: Ocular-Negative\n\nSubject shows
    no ocular response to visual stimuli at any tested distance. Confirmed non-functional
    sight across three trials.\n\nWhat's unsettling isn't the senses, it's what happens
    once it's found you. The instant it registers a sound source, response is immediate
    and total: no hesitation, no searching, straight into pursuit. Aggression on
    engagement far exceeds anything we've logged in the standard-presentation subjects.
    Movement speed also spikes well above resting state the moment it commits.\n\n(stop
    testing this one at close range. Almost lost my hand today)\n\n\u2014 T. Adeyemi,
    Behavioral Obs."
  m_isRightToLeft: 0
