  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Observation Log \u2014 Subject Class: Terminal Presentation\n\nAdvanced-stage
    subject, mass roughly 3x baseline. Mobility severely impaired : gait is slow,
    near-shuffling, consistent with skeletal/muscular overgrowth outpacing motor
    control.\n\nDo not let the slow movement fool anyone reading this. One contact
    event during testing resulted in near-total structural failure of a reinforced
    containment partition. Subject strength scales with mass in a way our models
    did not predict. A single hit is very likely unsurvivable.\n\nIf it's slow, that
    is the only mercy this stage offers. Use it. Do not get comfortable.\n\n\u2014
    R. Fenwick, Structural & Impact Assessment"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
